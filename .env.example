# Copy to .env next to the compose file. .env is gitignored.
# Only needed for gated repositories on Hugging Face; the benchmark itself
# runs fully offline once the weights are cached (HF_HUB_OFFLINE=1).
HF_TOKEN=hf_your_token_here
HUGGING_FACE_HUB_TOKEN=hf_your_token_here

# Read by serving/docker-compose.gemma4.yaml, which is the everyday serving
# config for the leading model rather than a benchmark script.
MODEL_ID=google/gemma-4-12B-it-qat-w4a16-ct
MAX_MODEL_LEN=131072
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=2
